{
  "name": "time-service",
  "version": "0.1.0",
  "description": "Habit Tracker time-service: dashboard, calendar, milestones, Google Calendar, admin analytics",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "jest",
    "mock": "node --env-file=.env scripts/mock-services.js",
    "db:init": "node --env-file=.env scripts/db-init.js",
    "check:upstreams": "node --env-file=.env scripts/check-upstreams.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/load/"
    ]
  }
}
