# Copy this file to .env (never commit .env). Placeholders only.
PORT=3003

# Shared secret between the gateway and the services. Same value in every service.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN=change-me

# Postgres. Locally:  postgresql://postgres:postgres@localhost:5432/habits
# On RDS add ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/habits

# The other services. On your own PC (npm run mock) use localhost; in docker compose use the service names.
HABITS_SERVICE_URL=http://localhost:3001
STREAKS_SERVICE_URL=http://localhost:3002

FRONTEND_URL=http://localhost:8080

# Google OAuth (Google Cloud console -> Credentials). Better: keep them in Secrets Manager (SECRETS_ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# AWS through Floci. Any credentials work with Floci. Leave AWS_ENDPOINT_URL empty on real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Printed by scripts/setup-aws.sh
KMS_KEY_ID=alias/time-service-google-tokens
SECRETS_ID=
CLOUDWATCH_LOG_GROUP=
