{
  "name": "habit-tracker-gateway",
  "version": "0.1.0",
  "description": "Habit Tracker gateway: Cognito login, accounts, admin, audit log, routing to service-a/b/c",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "jest",
    "db:init": "node --env-file=.env scripts/db-init.js",
    "seed:admin": "node --env-file=.env scripts/seed-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
