# Copy this file to .env (never commit .env). Placeholders only.
PORT=3000

# Shared secret between the gateway and the services. Same value in every service.
INTERNAL_TOKEN=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/habits

# The services (team names). On your own PC use http://localhost:3001 / 3002 / 3003.
HABITS_SERVICE_URL=http://service-a:3001
STREAKS_SERVICE_URL=http://service-b:3002
TIME_SERVICE_URL=http://service-c:3003

# Browser origins allowed to call the API (comma separated).
CORS_ORIGIN=http://localhost:8080
# Set to true only when the gateway runs behind a load balancer that sets X-Forwarded-For.
TRUST_PROXY=false

# AWS through Floci. Leave AWS_ENDPOINT_URL empty on real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Printed by scripts/setup-aws.sh
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
SECRETS_ID=
CLOUDWATCH_LOG_GROUP=
# Inside Docker the token issuer stays http://localhost:4566/<pool> while keys are read from Floci:
# COGNITO_ISSUER=http://localhost:4566/<pool id>
# COGNITO_JWKS_URL=http://floci:4566/<pool id>/.well-known/jwks.json
